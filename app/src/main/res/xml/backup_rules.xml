<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Vault app: do not cloud-back up encrypted DBs, prefs with key material, or card images. -->
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" path="cards" />
    <exclude domain="root" />
</full-backup-content>
